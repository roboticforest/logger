@INCLUDE = Doxyfile.common

# Specialized Config for Private Internal Developer Docs

OUTPUT_DIRECTORY       = @DOXY_INTERNAL_OUTPUT_DIRECTORY@

EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = YES

INPUT                  = @DOXY_INTERNAL_INPUTS@

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = SVG
INTERACTIVE_SVG        = YES

