DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Logger
PROJECT_NUMBER         = @DVLOGGER_DOC_PROJECT_NUMBER@
PROJECT_BRIEF          = "@DVLOGGER_DOC_INTERNAL_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = @DVLOGGER_DOC_INTERNAL_OUTPUT_DIRECTORY@
FULL_PATH_NAMES        = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 6
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
INPUT                  = @DVLOGGER_DOC_INTERNAL_INPUTS@
FILE_PATTERNS          = *.cppm *.cpp *.h *.hpp *.md
EXTENSION_MAPPING      = cppm=C++
RECURSIVE              = NO
EXCLUDE_PATTERNS       = @DVLOGGER_DOC_EXCLUDE_PATTERNS@
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = export=
IMPLICIT_DIR_DOCS      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
INTERNAL_DOCS          = YES
SOURCE_BROWSER         = YES
VERBATIM_HEADERS       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
PAGE_OUTLINE_PANEL     = YES
SEARCHENGINE           = YES
HTML_FOOTER            = @DVLOGGER_DOC_INTERNAL_HTML_FOOTER@
GENERATE_LATEX         = NO
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 40
MAX_DOT_GRAPH_DEPTH    = 2
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DIRECTORY_GRAPH        = NO
