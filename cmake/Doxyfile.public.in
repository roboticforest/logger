DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Logger
PROJECT_NUMBER         = @DVLOGGER_DOC_PROJECT_NUMBER@
PROJECT_BRIEF          = "@DVLOGGER_DOC_PUBLIC_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = @DVLOGGER_DOC_PUBLIC_OUTPUT_DIRECTORY@
FULL_PATH_NAMES        = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 6
QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
INPUT                  = @DVLOGGER_DOC_PUBLIC_INPUTS@
FILE_PATTERNS          = *.cppm *.cpp *.h *.hpp *.md
EXTENSION_MAPPING      = cppm=C++
RECURSIVE              = NO
EXCLUDE_PATTERNS       = @DVLOGGER_DOC_EXCLUDE_PATTERNS@
EXCLUDE_SYMBOLS        = @DVLOGGER_DOC_PUBLIC_EXCLUDE_SYMBOLS@
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = export=
IMPLICIT_DIR_DOCS      = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_UNDOC_NAMESPACES  = YES
INTERNAL_DOCS          = NO
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
PAGE_OUTLINE_PANEL     = YES
SEARCHENGINE           = YES
HTML_FOOTER            = @DVLOGGER_DOC_HTML_FOOTER@
GENERATE_LATEX         = NO
